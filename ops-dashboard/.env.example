# ops-dashboard — env vars (see .env.example for required list)

# Required: copy these from sage-web-api deployment
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required: bearer token to unlock the dashboard (any long random string)
ADMIN_TOKEN=

# Optional: HTTP port (Railway injects PORT in production; defaults to 2027 locally)
PORT=2027