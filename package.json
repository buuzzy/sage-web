    "nanoid": "^5.1.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "uuidv7": "^1.2.1",
    "xlsx": "^0.18.5"
